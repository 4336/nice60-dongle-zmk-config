 *
 * nice!60 동글 쉴드 오버레이
 * ─────────────────────────────────────────────────────────────
 * nice!nano v2 (nice_nano/nrf52840/zmk) 을 central로 설정.
 * 동글은 실제 키 스위치가 없으므로 mock_kscan을 사용한다.
 * 매트릭스 트랜스폼은 nice!60 board DTS의 ANSI 기본 레이아웃과
 * 동일한 구조여야 peripheral이 보내는 키 위치 인덱스와 일치한다.
 *
 * ★ 주의: 키 배치가 이상하면 ZMK 소스의 nice60 board DTS 내
 *   keymap_transform_0 과 대조하여 이 파일의 map을 수정할 것.
 *   (zmk/app/boards/nicekeyboards/nice60/ 디렉토리)
 * ─────────────────────────────────────────────────────────────
 */

#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &mock_kscan;
        zmk,physical-layout = &physical_layout0;
    };

    /* 동글에는 실제 키가 없으므로 빈 mock kscan 사용 */
    mock_kscan: mock_kscan_0 {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };

    /*
     * nice!60 ANSI 표준 레이아웃 매트릭스 트랜스폼
     * 총 61키 = 14 + 14 + 13 + 12 + 8
     *
     * Row 0 (14): ESC  1    2    3    4    5    6    7    8    9    0    -    =    BKSP
     * Row 1 (14): TAB  Q    W    E    R    T    Y    U    I    O    P    [    ]    |
     * Row 2 (13): FN   A    S    D    F    G    H    J    K    L    ;    '         ENT
     * Row 3 (12): SHFT      Z    X    C    V    B    N    M    ,    .    /         SHFT
     * Row 4 ( 8): CTL  ALT  GUI            SPC            ALT  GUI  CTL  FN
     *
     * ※ Row 2 col 12: ISO Enter용 빈칸 (ANSI 미사용)
     * ※ Row 3 col  1: 2.25u 좌 Shift 확장 영역 (미사용)
     * ※ Row 3 col 12: Split 우 Shift 선택 영역 (미사용)
     * ※ Row 4 col 3~5, 7~9: 6.25u Spacebar 확장 영역 (미사용)
     */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <14>;
        rows = <5>;
        map = <
            RC(0,0)  RC(0,1)  RC(0,2)  RC(0,3)  RC(0,4)  RC(0,5)  RC(0,6)  RC(0,7)  RC(0,8)  RC(0,9)  RC(0,10) RC(0,11) RC(0,12) RC(0,13)
            RC(1,0)  RC(1,1)  RC(1,2)  RC(1,3)  RC(1,4)  RC(1,5)  RC(1,6)  RC(1,7)  RC(1,8)  RC(1,9)  RC(1,10) RC(1,11) RC(1,12) RC(1,13)
            RC(2,0)  RC(2,1)  RC(2,2)  RC(2,3)  RC(2,4)  RC(2,5)  RC(2,6)  RC(2,7)  RC(2,8)  RC(2,9)  RC(2,10) RC(2,11)           RC(2,13)
            RC(3,0)           RC(3,2)  RC(3,3)  RC(3,4)  RC(3,5)  RC(3,6)  RC(3,7)  RC(3,8)  RC(3,9)  RC(3,10) RC(3,11)           RC(3,13)
            RC(4,0)  RC(4,1)  RC(4,2)                    RC(4,6)            RC(4,10) RC(4,11) RC(4,12) RC(4,13)
        >;
    };

    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "ANSI";
        transform = <&default_transform>;
        kscan = <&mock_kscan>;
    };
};

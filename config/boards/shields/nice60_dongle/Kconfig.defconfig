if SHIELD_NICE60_DONGLE

# PC에 표시될 키보드 이름 (최대 16자)
config ZMK_KEYBOARD_NAME
    default "nice!60 dongle"

# 동글이 central 역할 담당
config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_SPLIT
    default y

# nice!60 1개를 peripheral로 연결 (단일 키보드 = 1)
config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 1

# BT_MAX_CONN = peripheral 수(1) + BT 프로필 수(5) = 6
config BT_MAX_CONN
    default 6

# BT_MAX_PAIRED = BT_MAX_CONN과 동일하게 설정
config BT_MAX_PAIRED
    default 6

endif
